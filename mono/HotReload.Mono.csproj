<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Local.props" Condition="Exists('..\Local.props')" />

  <!--
    HotReload for Mono games (MelonLoader loads it through its net35 runtime on Unity's Mono). Same sources as the
    IL2CPP build, compiled with MONO defined. MonoGameDir: a Mono Unity game with MelonLoader installed; set it in
    ..\Local.props, the MELONLOADER_MONO_GAME_DIR environment variable, or with -p:MonoGameDir=...
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HotReload</AssemblyName>
    <RootNamespace>HotReload</RootNamespace>
    <Version>0.8.0</Version>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <MonoGameDir Condition="'$(MonoGameDir)' == ''">$(MELONLOADER_MONO_GAME_DIR)</MonoGameDir>
    <MLDir>$(MonoGameDir)\MelonLoader\net35</MLDir>
    <DeployFolder>Plugins</DeployFolder>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(MLDir)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <!-- The game's Unity modules, from <Game>_Data\Managed (wildcard: any game name). -->
    <Reference Include="$(MonoGameDir)\*_Data\Managed\UnityEngine.CoreModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(MonoGameDir)\*_Data\Managed\UnityEngine.InputLegacyModule.dll"><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(MLDir)\MelonLoader.dll')">
    <Error Text="MelonLoader not found under MonoGameDir '$(MonoGameDir)'. Point MonoGameDir at a Mono Unity game with MelonLoader 0.6+ installed (Local.props, MELONLOADER_MONO_GAME_DIR, or -p:MonoGameDir=...)." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(MonoGameDir)\$(DeployFolder)')">
    <PropertyGroup>
      <_DeployStamp>$([System.DateTime]::UtcNow.Ticks)</_DeployStamp>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFile Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
      <_DeployFile Remove="@(_DeployFile)" Condition="!Exists('%(FullPath)')" />
      <_DeployExisting Include="@(_DeployFile->'$(MonoGameDir)\$(DeployFolder)\%(Filename)%(Extension)')" />
      <_DeployExisting Remove="@(_DeployExisting)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Move SourceFiles="@(_DeployExisting)" DestinationFiles="@(_DeployExisting->'%(FullPath).$(_DeployStamp).hotreload-old')" ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployFile)" DestinationFolder="$(MonoGameDir)\$(DeployFolder)" Retries="3" RetryDelayMilliseconds="300" ContinueOnError="true" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="del /f /q &quot;$(MonoGameDir)\$(DeployFolder)\*.hotreload-old&quot; 2&gt;nul" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <Message Importance="high" Text="$(TargetFileName) (Mono) -> $(MonoGameDir)\$(DeployFolder)" />
  </Target>

</Project>
