<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HotReload</AssemblyName>
    <RootNamespace>HotReload</RootNamespace>
    <Version>0.5.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <!-- Game with MelonLoader installed: set it in Local.props (git-ignored, see Local.props.example),
         with the MELONLOADER_GAME_DIR environment variable, or with dotnet build -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">$(MELONLOADER_GAME_DIR)</GameDir>
    <MLDir>$(GameDir)\MelonLoader\net6</MLDir>
    <InteropDir>$(GameDir)\MelonLoader\Il2CppAssemblies</InteropDir>
    <!-- HotReload is a MelonLoader plugin: it must register before mods are loaded. -->
    <DeployFolder>Plugins</DeployFolder>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ and checker/ are separate projects -->
    <Compile Remove="tests/**;checker/**" />
    <None Remove="tests/**;checker/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MLDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Deploy to <game>/$(DeployFolder) (Mods for a mod). A running game keeps the DLL it loaded at startup open: Windows refuses to overwrite it but
    allows renaming it. So an existing copy is moved aside to *.hotreload-old (HotReload deletes those on the next launch)
    and the new build is copied in, where HotReload picks it up. Mods need this only with ShadowCopyMods = false; otherwise a plain copy into Mods works.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\$(DeployFolder)')">
    <PropertyGroup>
      <_DeployStamp>$([System.DateTime]::UtcNow.Ticks)</_DeployStamp>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFile Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
      <_DeployFile Remove="@(_DeployFile)" Condition="!Exists('%(FullPath)')" />
      <_DeployExisting Include="@(_DeployFile->'$(GameDir)\$(DeployFolder)\%(Filename)%(Extension)')" />
      <_DeployExisting Remove="@(_DeployExisting)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Move SourceFiles="@(_DeployExisting)" DestinationFiles="@(_DeployExisting->'%(FullPath).$(_DeployStamp).hotreload-old')" ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployFile)" DestinationFolder="$(GameDir)\$(DeployFolder)" Retries="3" RetryDelayMilliseconds="300" ContinueOnError="true" />
    <!-- Drop moved-aside copies nothing holds any more (fails silently for the ones the running game still has open). -->
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="del /f /q &quot;$(GameDir)\$(DeployFolder)\*.hotreload-old&quot; 2&gt;nul" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <Message Importance="high" Text="$(TargetFileName) -> $(GameDir)\$(DeployFolder)" />
  </Target>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(MLDir)\MelonLoader.dll')">
    <Error Text="MelonLoader not found under GameDir '$(GameDir)'. Point GameDir at a game with MelonLoader 0.6+ installed and started once (so MelonLoader\Il2CppAssemblies exists): create Local.props from Local.props.example, set MELONLOADER_GAME_DIR, or pass -p:GameDir=..." />
  </Target>

</Project>
