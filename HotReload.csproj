<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <!--
    HotReload: one DLL for Mono and IL2CPP games. net472 runs on Unity's Mono (4.x profile) and on the .NET 6 runtime
    MelonLoader uses in IL2CPP games; runtime differences are decided at runtime (src/Compat.cs).
    It compiles against the net35 assemblies of the NuGet packages, the oldest copies any game has: MelonLoader runs its
    net35 build in Mono games, which ships Mono.Cecil 0.10.4. .NET 6 accepts the newer 0.11.6 of IL2CPP games for a
    0.10.4 reference. PackageDownload fetches the packages without adding them to the dependency graph, where the
    net472 group would pull Cecil 0.11.6. No game needed to build.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HotReload</AssemblyName>
    <RootNamespace>HotReload</RootNamespace>
    <Version>$(HotReloadVersion)</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <MelonLoaderVersion>0.7.3</MelonLoaderVersion>
    <HarmonyXVersion>2.10.2</HarmonyXVersion>
    <CecilVersion>0.10.4</CecilVersion>
    <!-- Optional: games with MelonLoader to copy the build into (their Plugins folder) after each build. Set them in
         Local.props (git-ignored, see Local.props.example), with the MELONLOADER_GAME_DIR / MELONLOADER_MONO_GAME_DIR
         environment variables, or with -p:GameDir=... / -p:MonoGameDir=... ; -p:DeployToGame=false skips the copy. -->
    <GameDir Condition="'$(GameDir)' == ''">$(MELONLOADER_GAME_DIR)</GameDir>
    <MonoGameDir Condition="'$(MonoGameDir)' == ''">$(MELONLOADER_MONO_GAME_DIR)</MonoGameDir>
    <!-- HotReload is a MelonLoader plugin: it must register before mods are loaded. -->
    <DeployFolder>Plugins</DeployFolder>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/, checker/ and tools/ are separate projects -->
    <Compile Remove="tests/**;checker/**;tools/**" />
    <None Remove="tests/**;checker/**;tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="LavaGang.MelonLoader" Version="[$(MelonLoaderVersion)]" />
    <PackageDownload Include="HarmonyX" Version="[$(HarmonyXVersion)]" />
    <PackageDownload Include="Mono.Cecil" Version="[$(CecilVersion)]" />
    <Reference Include="MelonLoader"><HintPath>$(NuGetPackageRoot)lavagang.melonloader/$(MelonLoaderVersion)/lib/net35/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(NuGetPackageRoot)harmonyx/$(HarmonyXVersion)/lib/net35/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(NuGetPackageRoot)mono.cecil/$(CecilVersion)/lib/net40/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- VersionInfo.Version / DownloadLink for [MelonInfo], generated from Directory.Build.props. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
  </ItemGroup>
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_BuildInfoLine Include="// &lt;auto-generated/&gt; from Directory.Build.props" />
      <_BuildInfoLine Include="namespace HotReload%3B" />
      <_BuildInfoLine Include="internal static class VersionInfo" />
      <_BuildInfoLine Include="{" />
      <_BuildInfoLine Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <_BuildInfoLine Include="    public const string DownloadLink = &quot;$(HotReloadRepository)/releases/latest&quot;%3B" />
      <_BuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Every configured game; the deploy target runs once per game (target batching). -->
  <ItemGroup Condition="'$(DeployToGame)' == 'true'">
    <_DeployGame Include="$(GameDir)" Condition="'$(GameDir)' != '' And Exists('$(GameDir)\$(DeployFolder)')" />
    <_DeployGame Include="$(MonoGameDir)" Condition="'$(MonoGameDir)' != '' And Exists('$(MonoGameDir)\$(DeployFolder)')" />
  </ItemGroup>

  <!--
    Deploy to <game>/Plugins. A running game keeps the DLL it loaded at startup open: Windows refuses to overwrite it but
    allows renaming it. So an existing copy is moved aside to *.hotreload-old (HotReload deletes those on the next launch)
    and the new build is copied in; the running game keeps the old build until it restarts.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'@(_DeployGame)' != ''" Outputs="%(_DeployGame.Identity)">
    <PropertyGroup>
      <_DeployStamp>$([System.DateTime]::UtcNow.Ticks)</_DeployStamp>
      <_DeployDir>%(_DeployGame.Identity)\$(DeployFolder)</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFile Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
      <_DeployFile Remove="@(_DeployFile)" Condition="!Exists('%(FullPath)')" />
      <_DeployExisting Include="@(_DeployFile->'$(_DeployDir)\%(Filename)%(Extension)')" />
      <_DeployExisting Remove="@(_DeployExisting)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Move SourceFiles="@(_DeployExisting)" DestinationFiles="@(_DeployExisting->'%(FullPath).$(_DeployStamp).hotreload-old')" ContinueOnError="true" />
    <Copy SourceFiles="@(_DeployFile)" DestinationFolder="$(_DeployDir)" Retries="3" RetryDelayMilliseconds="300" ContinueOnError="true" />
    <!-- Drop moved-aside copies nothing holds any more (fails silently for the ones the running game still has open). -->
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="del /f /q &quot;$(_DeployDir)\*.hotreload-old&quot; 2&gt;nul" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <Message Importance="high" Text="$(TargetFileName) -> $(_DeployDir)" />
    <ItemGroup>
      <_DeployFile Remove="@(_DeployFile)" />
      <_DeployExisting Remove="@(_DeployExisting)" />
    </ItemGroup>
  </Target>

</Project>
